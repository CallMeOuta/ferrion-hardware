CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_PCI_LEGACY=n
CONFIG_NET=y
CONFIG_EXPERT=y
CONFIG_WLAN=y
CONFIG_WIRELESS=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_MAC80211_RC_MINSTREL=y
CONFIG_MAC80211_HWSIM=y
CONFIG_MAC80211_RC_DEFAULT_MINSTREL=y
CONFIG_NETDEVICES=y
CONFIG_CRYPTO=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_CCM=y
CONFIG_CRYPTO_GCM=y
CONFIG_CRYPTO_CMAC=y
CONFIG_CRYPTO_GHASH=y
CONFIG_CRYPTO_MANAGER_DISABLE_TESTS=y
CONFIG_CFG80211_CERTIFICATION_ONUS=y
CONFIG_CFG80211_DEFAULT_PS=n
CONFIG_CFG80211_CRDA_SUPPORT=n
CONFIG_CFG80211_WEXT=n
CONFIG_CFG80211_REQUIRE_SIGNED_REGDB=n
CONFIG_CFG80211_USE_KERNEL_REGDB_KEYS=n
CONFIG_MAC80211_MESH=n
CONFIG_WEXT_CORE=n
CONFIG_RFKILL=n
CONFIG_DEBUG_FS=n
CONFIG_PM=n
CONFIG_ACPI=n
CONFIG_SMP=n
CONFIG_PREEMPT_NONE=y
