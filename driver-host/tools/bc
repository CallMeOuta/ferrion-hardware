import math
import sys


def fmul(b, n, d):
    return (2**b * n + d - 1) // d


def fadj(b, n, d):
    d = d // math.gcd(n, d)
    return 2**b * (d - 1) // d


def fmuls(b, n, d):
    s = 0
    while fmul(s, n, d) < 2 ** (b - 1):
        s += 1
    return s


def block(out, name, inv, n, d):
    s = fmuls(32, n, d)
    out.append(f"#define {name}_MUL32\tU64_C(0x{fmul(s, n, d):X})\n")
    out.append(f"#define {name}_ADJ32\tU64_C(0x{fadj(s, n, d):X})\n")
    out.append(f"#define {name}_SHR32\t{s}\n")


def ratio(out, a, b, unit, hz):
    cd = math.gcd(hz, unit)
    out.append(f"#define {a}_NUM\t\t{unit // cd}\n")
    out.append(f"#define {a}_DEN\t\t{hz // cd}\n")
    out.append(f"#define {b}_NUM\t\t{hz // cd}\n")
    out.append(f"#define {b}_DEN\t\t{unit // cd}\n")


hz = int(sys.stdin.read().strip())
assert hz >= 2
out = [
    "/* Automatically generated by kernel/time/timeconst.bc */\n",
    f"/* Time conversion constants for HZ == {hz} */\n",
    "\n",
    "#ifndef KERNEL_TIMECONST_H\n",
    "#define KERNEL_TIMECONST_H\n\n",
    "#include <linux/param.h>\n",
    "#include <linux/types.h>\n\n",
    f"#if HZ != {hz}\n",
    '#error "include/generated/timeconst.h has the wrong HZ value!"\n',
    "#endif\n\n",
]
block(out, "HZ_TO_MSEC", None, 1000, hz)
block(out, "MSEC_TO_HZ", None, hz, 1000)
ratio(out, "HZ_TO_MSEC", "MSEC_TO_HZ", 1000, hz)
out.append("\n")
block(out, "HZ_TO_USEC", None, 1000000, hz)
block(out, "USEC_TO_HZ", None, hz, 1000000)
ratio(out, "HZ_TO_USEC", "USEC_TO_HZ", 1000000, hz)
ratio(out, "HZ_TO_NSEC", "NSEC_TO_HZ", 1000000000, hz)
out.append("\n")
out.append("#endif /* KERNEL_TIMECONST_H */\n")
sys.stdout.write("".join(out))
